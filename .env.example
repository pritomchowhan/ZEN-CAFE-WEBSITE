# GEMINI_API_KEY: Required for Gemini AI API calls.
# Add your real Gemini API key in your hosting environment or local .env file.
# Never commit real secrets to the repository.
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Resend configuration for the official founder contact form.
# Add these values in the Vercel project settings, not in client-side code.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
CONTACT_RECIPIENT_EMAIL="zencafe1119@gmail.com"
CONTACT_FROM_EMAIL="Zen Cafe Website <hello@your-verified-domain.com>"
